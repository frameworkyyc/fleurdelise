---
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBookBar from '../components/StickyBookBar.astro';
import GardenVine from '../components/garden/GardenVine.astro';
import { site } from '../data/site';
interface Props { title: string; description: string; path?: string; home?: boolean; image?: string; jsonLd?: object[]; bookBar?: boolean; noindex?: boolean }
const { title, description, path = Astro.url.pathname, home = false, image = '/brand/og-image.jpg', jsonLd = [], bookBar = true, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;
// Staging / preview builds are never indexed. Production must opt in with PUBLIC_SITE_ENV=production.
const robots = noindex || !site.isProduction ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1f0913" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    {site.isProduction && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} logo on velvet plum`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!document.documentElement.dataset.garden)document.documentElement.classList.add('garden-fail')},4000)</script>
    {home && (
      <script is:inline set:html={`(function(){var h=document.documentElement,c=navigator.connection||{},q=location.search;
        if(/[?&]bloom=off/.test(q))return;                      /* ?bloom=off forces the static logo (A/B testing) */
        try{if(sessionStorage.getItem('fdl-bloom-seen'))return}catch(e){}
        if(matchMedia('(prefers-reduced-motion: reduce)').matches||!window.WebGLRenderingContext)return;
        if((c.saveData||/(^|-)[23]g$/.test(c.effectiveType||'')||navigator.hardwareConcurrency<=2||navigator.deviceMemory<=2))return;
        h.classList.add('bloom-pending');
        /* independent failsafe: if the player never started, reveal the static logo and release the text */
        setTimeout(function(){if(h.dataset.bloom!=='playing'){h.classList.remove('bloom-pending');h.classList.add('hero-go')}},3500)})()`} />
    )}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class:list={[bookBar && 'has-bookbar']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <GardenVine />
    <Header home={home} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    {bookBar && <StickyBookBar />}
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/forms.ts"></script>
    <script src="../scripts/garden.ts"></script>
    <script src="../scripts/bloom.ts"></script>
  </body>
</html>
<style is:global>
  @media (max-width: 899px) { body.has-bookbar .site-footer { padding-bottom: calc(24px + env(safe-area-inset-bottom)); } }
</style>
