---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import sitPhoto from '../assets/photos/sit.jpg';
import { sit } from '../data/site';
---
<section class="section tex-midnight on-dark sit" aria-labelledby="sit-title">
  <!-- the photo + scrim live in their OWN clipped layer, so the section itself never needs overflow:hidden (that is what clipped the old divider) -->
  <div class="bg" aria-hidden="true">
    <Picture src={sitPhoto} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="100vw" loading="lazy" decoding="async" class="ph" />
    <span class="scrim"></span>
  </div>
  <div class="wrap">
    <div class="copy">
      <p class="eyebrow reveal">Coming {sit.launch}</p>
      <h2 id="sit-title" class="reveal" style="--d:1">{sit.name}<span class="sr-only"> ({sit.short})</span></h2>
      <p class="lead reveal" style="--d:2">{sit.short} joins the services at Fleur de Lise Healing on <time datetime={sit.launchISO}>{sit.launch}</time>. If you’d like to hear when sessions open, send a note and I’ll be in touch.</p>
      <div class="actions reveal" style="--d:3">
        <Button href="/contact?interest=sit">Ask to be notified</Button>
        <a class="link-arrow" href={sit.href}>About {sit.short}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .sit { padding-block: clamp(48px, 8vw, 112px); }
  .bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .bg :global(.ph) { width: 100%; height: 100%; object-fit: cover; object-position: 78% 40%; }
  /* mobile: even deep wash so the white-on-photo text always clears 4.5:1; wider screens: text side stays dark, flame side shows */
  .scrim { position: absolute; inset: 0; background: linear-gradient(105deg, rgb(31 9 19 / .92) 0%, rgb(31 9 19 / .86) 52%, rgb(31 9 19 / .5) 100%); }
  .copy { max-width: 560px; }
  .copy h2 { margin: 10px 0 16px; }
  .lead { color: var(--ivory); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 26px; }
  /* phones: the candle is a full-bleed strip across the top that melts into Midnight; the copy sits on solid Midnight below it (guaranteed contrast) */
  @media (max-width: 1099px) {
    .sit { padding-top: 150px; }
    .bg { bottom: auto; height: 250px; }
    .bg :global(.ph) { object-position: 100% 30%; }
    /* fully opaque Midnight by the time the copy starts (y=150), so no photo ever sits behind text */
    .scrim { background: linear-gradient(180deg, rgb(31 9 19 / .08) 0%, rgb(31 9 19 / .5) 38%, rgb(31 9 19 / 1) 60%); }
  }
  @media (min-width: 1100px) { .sit { padding-top: clamp(48px, 8vw, 112px); } .bg { bottom: 0; height: auto; } .scrim { background: linear-gradient(90deg, rgb(31 9 19 / .94) 0%, rgb(31 9 19 / .82) 46%, rgb(31 9 19 / .18) 100%); } .bg :global(.ph) { object-position: 70% 42%; } }
</style>
