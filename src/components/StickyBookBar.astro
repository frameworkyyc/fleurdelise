---
import { site } from '../data/site';
---
<aside class="book-bar" data-book-bar aria-label="Quick booking" aria-hidden="true">
  <a class="btn" href={site.book.href} tabindex="-1">{site.book.cta}</a>
</aside>
<style>
  /* Compact floating pill (replaces the 72px full-width bar). Hidden whenever it would sit over another control, the footer, the open menu or the on-screen
     keyboard — logic in src/scripts/site.ts. 46px tall = comfortable tap target. */
  .book-bar { position: fixed; left: 50%; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 40; max-width: calc(100% - 28px); transform: translate(-50%, 160%); transition: transform .5s var(--ease), opacity .3s; visibility: hidden; opacity: 0; }
  .book-bar.is-visible { transform: translate(-50%, 0); visibility: visible; opacity: 1; }
  .book-bar .btn { min-height: 46px; padding: 10px 24px; border-radius: 999px; white-space: nowrap; font-size: .75rem; letter-spacing: .13em; box-shadow: 0 12px 28px -10px rgb(0 0 0 / .75), 0 0 0 1px rgb(31 9 19 / .4); }
  .book-bar .btn:hover { transform: none; }
  @media (max-width: 359px) { .book-bar .btn { padding-inline: 16px; font-size: .6875rem; letter-spacing: .1em; } }
  @media (min-width: 900px) { .book-bar { display: none; } }
  @media (prefers-reduced-motion: reduce) { .book-bar { transition: opacity .2s; } }
</style>
