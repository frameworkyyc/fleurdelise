---
// Small scroll-grown botanical glyph (line art, currentColor). kind: "bud" | "leaf" | "flower".
// Self-contained: carries its own data-grow so it grows as it scrolls into view. Decorative.
interface Props { kind?: 'bud' | 'leaf' | 'flower'; size?: number; class?: string }
const { kind = 'bud', size = 56, class: cls } = Astro.props;
const petal = 'M0 0C6-8 6-20 0-28C-6-20-6-8 0 0Z';
---
<span class:list={['sprout', cls]} data-grow data-grow-start=".96" data-grow-end=".62" aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 64 64" focusable="false">
    <g transform="translate(32 60)">
      <path class="sp-stem gl g-draw" style="--s:0;--w:.45" d="M0 0C-2-14 2-28 0-40" />
      <g transform="translate(-1 -22)"><path class="sp-leaf gl g-pop" style="--s:.3;--w:.35;transform-origin:0 0" d="M0 0C-8-2-16-8-18-16C-9-14-3-8 0 0Z" /></g>
      <g transform="translate(1 -30)"><path class="sp-leaf gl g-pop" style="--s:.4;--w:.35;transform-origin:0 0" d="M0 0C8-2 16-8 18-16C9-14 3-8 0 0Z" /></g>
      {kind === 'bud' && (
        <g transform="translate(0 -40)">
          <path class="sp-pet gl g-pop" style="--s:.55;--w:.4" d={petal} />
          <g class="sp-fan gl" style="--th:-30;--s:.6;--w:.4"><path class="sp-pet" d={petal} /></g>
          <g class="sp-fan gl" style="--th:30;--s:.6;--w:.4"><path class="sp-pet" d={petal} /></g>
        </g>
      )}
      {kind === 'flower' && (
        <g transform="translate(0 -40)">
          {[0, -26, 26, -52, 52].map((th, i) => (
            <g class="sp-fan gl" style={`--th:${th};--s:${(0.5 + i * 0.06).toFixed(2)};--w:.4`}><path class="sp-pet" d={petal} /></g>
          ))}
        </g>
      )}
      {kind === 'leaf' && (
        <g transform="translate(0 -40)"><path class="sp-pet gl g-pop" style="--s:.55;--w:.4" d="M0 0C7-5 9-14 0-24C-9-14-7-5 0 0Z" /></g>
      )}
    </g>
  </svg>
</span>
<style>
  .sprout { display: inline-block; line-height: 0; color: var(--bronze); }
  :global(.on-dark) .sprout { color: var(--gold); }
  .sprout svg { overflow: visible; }
  .sprout :global(*) { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .sp-leaf { opacity: var(--lp); transform: scale(calc(.2 + .8 * var(--lp))); }
  .sp-fan { transform: rotate(calc(var(--th) * 1deg * var(--lp))); transform-origin: 0 0; }
  .sp-pet { opacity: var(--lp); transform: scale(calc(.2 + .8 * var(--lp))); transform-origin: 0 0; }
</style>
