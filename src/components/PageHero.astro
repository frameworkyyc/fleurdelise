---
import Icon from './Icon.astro';
import Moons from './Moons.astro';
import type { IconName } from '../data/site';
interface Props { eyebrow?: string; title: string; lead?: string; icon?: IconName; crumbs?: { name: string; href?: string }[] }
const { eyebrow, title, lead, icon, crumbs } = Astro.props;
---
<section class="page-hero tex-plum on-dark">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap inner">
    {crumbs && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>{crumbs.map((c, i) => <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
      </nav>
    )}
    {icon && <Icon name={icon} size={64} class="ico" />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    <Moons class="moons" />
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding: calc(var(--header-h) + clamp(56px, 8vw, 104px)) 0 clamp(64px, 8vw, 112px); text-align: center; isolation: isolate; }
  .glow { position: absolute; z-index: -1; width: 90vmin; height: 90vmin; left: 50%; top: 20%; translate: -50% -50%; border-radius: 50%; background: radial-gradient(circle, rgb(207 128 92 / .22) 0%, rgb(160 87 58 / .08) 40%, transparent 70%); }
  .inner { display: flex; flex-direction: column; align-items: center; gap: 0; animation: rise 1.2s var(--ease-slow) both; }
  .inner :global(.ico) { color: var(--gold); margin-bottom: 20px; }
  .eyebrow { color: var(--gold); margin-bottom: 20px; }
  h1 { font-size: clamp(2.125rem, 1.6rem + 2.4vw, 3.25rem); max-width: 20ch; text-wrap: balance; }
  .crumbs { margin-bottom: 22px; font-size: .75rem; letter-spacing: .08em; }
  .crumbs ol { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 0; margin: 0; padding: 0; list-style: none; }
  .crumbs li + li::before { content: '›'; margin: 0 10px; color: var(--gold); opacity: .7; }
  .crumbs a { display: inline-block; padding-block: 13px; margin-block: -13px; color: var(--ivory-80); text-decoration: underline; text-decoration-color: var(--gold-line); text-underline-offset: 6px; text-decoration-thickness: 1px; } .crumbs a:hover { color: var(--ivory); text-decoration-color: var(--gold); }
  .crumbs [aria-current] { color: var(--ivory-60); }
  .lead { max-width: 52ch; margin-top: 24px; color: var(--ivory-80); }
  .inner :global(.moons) { color: var(--gold); opacity: .7; margin-top: 48px; width: 120px; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .inner { animation: none; } }
</style>
