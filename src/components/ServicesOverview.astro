---
// Three photographic "doorways". Each tile is one large link (real <h3><a> text stays in the HTML for SEO); the line illustration shrinks to a gold badge.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ServiceIllustration from './garden/ServiceIllustration.astro';
import { services } from '../data/site';
import reiki from '../assets/photos/reiki.jpg';
import eft from '../assets/photos/eft.jpg';
import tarot from '../assets/photos/tarot.jpg';
const photos: Record<string, { src: ImageMetadata; pos: string }> = {
  reiki: { src: reiki, pos: '50% 42%' },
  eft: { src: eft, pos: '50% 58%' },
  tarot: { src: tarot, pos: '50% 62%' },
};
---
<section class="section tex-midnight on-dark services" aria-labelledby="services-title">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow reveal">Services</p>
      <h2 id="services-title" class="reveal" style="--d:1">Gentle support for whatever you’re carrying.</h2>
      <p class="modes reveal" style="--d:2">
        <span><Icon name="inperson" size={22} /> In person</span>
        <span><Icon name="virtual" size={22} /> Virtual</span>
        <span class="note">depending on the service</span>
      </p>
    </header>
    <ul class="tiles">
      {services.map((s, i) => (
        <li class={`tile tile-${s.slug} svc-host reveal`} style={`--d:${i}`}>
          <Picture src={photos[s.slug].src} alt="" formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(max-width: 699px) 100vw, (max-width: 1100px) 33vw, 380px" loading="lazy" decoding="async" class="ph" style={`object-position:${photos[s.slug].pos}`} />
          <span class="scrim" aria-hidden="true"></span>
          <span class="badge" aria-hidden="true"><ServiceIllustration variant={s.slug as 'reiki' | 'eft' | 'tarot'} size={44} /></span>
          <div class="tx">
            <h3><a href={s.href}>{s.name}</a></h3>
            <p>{s.blurb}</p>
            <span class="more" aria-hidden="true">Learn more <Icon name="arrow" size={16} /></span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .head { max-width: 640px; margin-bottom: clamp(26px, 5vw, 56px); }
  .head h2 { margin: 10px 0 16px; }
  .modes { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 22px; color: var(--ivory-80); font-size: .9375rem; }
  .modes span { display: inline-flex; align-items: center; gap: 8px; }
  .modes :global(svg) { color: var(--gold); }
  .modes .note { color: var(--ivory-60); font-size: .875rem; }
  .tiles { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; list-style: none; margin: 0; padding: 0; }
  .tile { position: relative; isolation: isolate; overflow: hidden; min-width: 0; border-radius: 4px; min-height: 224px; display: flex; align-items: flex-end; background: var(--midnight);
    box-shadow: 0 0 0 1px rgb(201 148 76 / .28); transition: transform .6s var(--ease), box-shadow .6s var(--ease); }
  .tile :global(.ph) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--ease-slow); }
  /* plum/midnight scrim = guaranteed text contrast (verified ≥ 4.5:1 by the QA script) and keeps every photo inside the brand palette */
  .scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(31 9 19 / .98) 0%, rgb(31 9 19 / .95) 52%, rgb(31 9 19 / .72) 76%, rgb(31 9 19 / .05) 100%); }
  .badge { position: absolute; top: 14px; right: 14px; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgb(31 9 19 / .62); box-shadow: 0 0 0 1px rgb(201 148 76 / .55); color: var(--gold); }
  .tx { padding: 18px 20px 18px; max-width: 34rem; }
  .tx h3 { font-family: var(--font-serif); font-style: italic; font-weight: 400; font-size: 1.625rem; line-height: 1.15; color: var(--ivory); }
  .tx h3 a { text-decoration: none; }
  .tx h3 a::after { content: ''; position: absolute; inset: 0; } /* whole tile is the link (.tile is the positioned ancestor) */
  .tx p { margin-top: 6px; color: var(--ivory); font-size: .9375rem; line-height: 1.5; max-width: 30ch; }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 500; color: var(--gold); }
  .more :global(svg) { transition: transform .4s var(--ease); }
  .tile:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px rgb(201 148 76 / .6), 0 28px 44px -28px rgb(0 0 0 / .8); }
  .tile:hover :global(.ph) { transform: scale(1.04); } .tile:hover .more :global(svg) { transform: translateX(5px); }
  .tile:focus-within { outline: 3px solid var(--gold); outline-offset: 4px; } .tx h3 a:focus-visible { outline: none; }
  @media (min-width: 700px) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .tile { aspect-ratio: 4 / 5; min-height: 0; } .tx { padding: 22px 20px 22px; } .tx h3 { font-size: 1.75rem; } .badge { top: 16px; right: 16px; }
  }
  @media (min-width: 1100px) { .tiles { gap: 28px; } .tx { padding: 28px 28px 30px; } }
  @media (prefers-reduced-motion: reduce) { .tile, .tile :global(.ph) { transition: none; } .tile:hover { transform: none; } .tile:hover :global(.ph) { transform: none; } }
</style>
