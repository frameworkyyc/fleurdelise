---
import Button from './Button.astro';
import { site } from '../data/site';
// Deterministic "gold dust" so builds are stable (no Math.random at render time).
const motes = Array.from({ length: 18 }, (_, i) => {
  const r = (n: number) => { const x = Math.sin((i + 1) * 9301 + n * 49297) * 233280; return x - Math.floor(x); };
  return { x: Math.round(r(1) * 100), s: 2 + Math.round(r(2) * 2), d: 14 + Math.round(r(3) * 14), delay: -Math.round(r(4) * 26), o: 0.35 + r(5) * 0.45 };
});
const stars = [{ x: 14, y: 24, d: 0 }, { x: 86, y: 30, d: 1.6 }, { x: 22, y: 70, d: 3.1 }, { x: 80, y: 74, d: 2.2 }];
---
<section class="hero tex-plum on-dark" aria-labelledby="hero-title" data-hero>
  <div class="glow" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="dust" aria-hidden="true">
    {motes.map((m) => <i style={`--x:${m.x}%;--s:${m.s}px;--d:${m.d}s;--delay:${m.delay}s;--o:${m.o}`}></i>)}
    {stars.map((s) => (
      <svg class="twinkle" style={`left:${s.x}%;top:${s.y}%;--delay:${s.d}s`} viewBox="0 0 24 24" width="14" height="14"><path d="M12 1c.7 6.5 2.500 9.300 11 11-8.500 1.700-10.300 4.500-11 11-.7-6.500-2.500-9.300-11-11 8.500-1.700 10.300-4.500 11-11z" fill="currentColor" /></svg>
    ))}
  </div>

  <div class="wrap hero-in">
    <!--
      SAFARI-SAFE — DO NOT add animated filters here. The original blur()/drop-shadow() keyframes rendered as a white
      rectangle on iPad Safari Private Browsing (docs/SAFARI-LOGO.md). Animate opacity/transform only; keep fill-mode
      `backwards` so the base state is always visible. (Enforced by scripts/check-motion.mjs.)
    -->
    <div class="hero-logo-frame" data-bloom-frame>
      <div class="hero-logo-media">
        <span class="hero-logo-shadow" aria-hidden="true"></span>
      <picture>
        <source type="image/webp" srcset="/brand/logo-dark-768.webp 768w, /brand/logo-dark-1024.webp 1024w, /brand/logo-dark-1280.webp 1280w, /brand/logo-dark-1536.webp 1536w" sizes="(max-width: 700px) 92vw, 640px" />
        <img class="hero-logo" data-hero-logo src="/brand/logo-dark-1024.png" width="1536" height="1024" alt={`${site.name} — lotus, crescent moon and stars`} fetchpriority="high" />
      </picture>
      </div>
      <!--
        Cinematic bloom (src/scripts/bloom.ts): an AI-generated lotus bloom (Higgsfield, Wan 3.0) is played as a
        stacked-alpha video on this canvas, the approved lettering fades in beneath it, then everything hands off to the
        EXACT static logo above. Hidden unless html.bloom-pending; the static logo is always the fallback.
      -->
      <div class="bloom-stage" aria-hidden="true">
        <canvas class="bloom-canvas"></canvas>
        <video class="bloom-video" muted preload="auto" tabindex={-1} {...({ playsinline: true, disablepictureinpicture: true, disableremoteplayback: true } as any)}></video>
      </div>
      <img class="bloom-word" src="/brand/logo-wordmark-1024.webp" alt="" width="1536" height="1024" aria-hidden="true" decoding="async" />
    </div>
    <p class="eyebrow hero-eyebrow">Reiki · EFT · Tarot <span aria-hidden="true">—</span> Windsor, Ontario</p>
    <h1 id="hero-title" class="display hero-tag">
      <span class="line">{site.tagline[0]}</span>
      <span class="line">{site.tagline[1]}</span>
    </h1>
    <p class="lead hero-lead">Gentle, personal wellness support in Windsor, Ontario — in person or virtually, depending on the service.</p>
    <div class="hero-cta">
      <Button href={site.book.href} data-hero-cta>{site.book.cta}</Button>
      <a class="link-arrow" href="/services">Explore services</a>
    </div>
  </div>
  <a class="scroll-cue" href="#welcome" aria-label="Scroll to content"><span></span></a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: center; padding: calc(var(--header-h) + 8px) 0 72px; overflow: hidden; text-align: center; }
  .hero-in { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; }

  .hero-logo-frame { position: relative; width: clamp(280px, min(92vw, 640px, calc((100svh - 520px) * 1.5)), 640px); margin-bottom: 8px; }
  /* the EXACT logo: base state fully visible; animation (opacity/transform only) just brings it in after the bloom */
  .hero-logo-media { position: relative; isolation: isolate; animation: logo-in 1.2s var(--ease-slow) backwards .1s; }
  .hero-logo { display: block; width: 100%; height: auto; }
  /* soft ambient shadow — replaces the former `filter: drop-shadow()`; animated filters broke iPad Safari Private Browsing */
  .hero-logo-shadow { position: absolute; z-index: -1; inset: 18% 6% -6%; background: radial-gradient(closest-side, rgb(0 0 0 / .34), rgb(0 0 0 / .14) 55%, transparent 100%); }
  /* ---- cinematic bloom layers (opacity/transform only; no filters) ---- */
  /* the packed video covers only the emblem's footprint: logo-space crop 150,0,1240,700 of the 1536x1024 logo box (see public/brand/bloom/bloom.json) */
  .bloom-stage { position: absolute; z-index: 3; left: 9.7656%; top: 0; width: 80.7292%; height: 68.3594%; pointer-events: none; visibility: hidden; }
  .bloom-canvas { display: block; width: 100%; height: 100%; }
  .bloom-video { position: absolute; left: 0; top: 0; width: 16px; height: 16px; opacity: 0; pointer-events: none; } /* not 1px: keep it a real, in-viewport video so WebKit never treats it as invisible */
  .bloom-word { position: absolute; z-index: 2; left: 0; top: 0; width: 100%; height: auto; pointer-events: none; visibility: hidden; opacity: 0; transform: translateY(8px); transition: opacity .9s var(--ease), transform .9s var(--ease); }
  :global(html.bloom-pending) .bloom-stage, :global(html.bloom-pending) .bloom-word, :global(html.bloom-done) .bloom-stage, :global(html.bloom-done) .bloom-word { visibility: visible; }
  :global(html.bloom-word-in) .bloom-word { opacity: 1; transform: none; }
  /* ambient hero animations rest while the bloom plays (frees the compositor for the video); they resume at hand-off */
  :global(html.bloom-pending) .glow, :global(html.bloom-pending) .dust i, :global(html.bloom-pending) .twinkle, :global(html.bloom-pending) .scroll-cue span { animation-play-state: paused; }
  /* while the bloom plays the static logo waits (hidden); hero text waits for the 'hero-go' cue */
  :global(html.bloom-pending) .hero-logo-media { animation: none; }
  :global(html.bloom-pending) .hero-logo-media picture { opacity: 0; } /* ambient shadow stays visible so nothing pulses at hand-off */
  :global(html.bloom-pending:not(.hero-go)) .hero-eyebrow, :global(html.bloom-pending:not(.hero-go)) .hero-tag .line, :global(html.bloom-pending:not(.hero-go)) .hero-lead, :global(html.bloom-pending:not(.hero-go)) .hero-cta { animation-play-state: paused; }
  /* hand-off: the exact static logo fades in as the canvas + lettering layer fade out (identical pixels beneath) */
  :global(html.bloom-done) .hero-logo-media { animation: none; }
  :global(html.bloom-done) .hero-logo-media picture { transition: opacity .5s var(--ease); }
  :global(html.bloom-done) .bloom-stage, :global(html.bloom-done) .bloom-word { opacity: 0; transition: opacity .5s var(--ease); }
  .hero-eyebrow { color: var(--gold); margin: 12px 0 20px; animation: rise 1.4s var(--ease-slow) backwards .2s; max-width: 30ch; text-wrap: balance; }
  .hero-tag { display: grid; gap: 2px; }
  .hero-tag .line { display: block; text-wrap: balance; animation: rise 1.6s var(--ease-slow) backwards; }
  .hero-tag .line:nth-child(1) { animation-delay: .35s; }
  .hero-tag .line:nth-child(2) { animation-delay: .6s; }
  .hero-lead { max-width: 46ch; margin: 24px auto 0; color: var(--ivory-80); animation: rise 1.4s var(--ease-slow) backwards .9s; }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 32px; margin-top: 36px; animation: rise 1.4s var(--ease-slow) backwards 1.2s; }

  /* candlelight glow (Brand Kit §05 "Ritual") */
  .glow { position: absolute; z-index: 0; width: 120vmin; height: 120vmin; left: 50%; top: 34%; transform: translate(-50%, -50%); border-radius: 50%;
    background: radial-gradient(circle, rgb(207 128 92 / .20) 0%, rgb(160 87 58 / .09) 34%, transparent 66%); animation: breathe 11s ease-in-out infinite; }
  .vignette { position: absolute; inset: 0; z-index: 1; background: radial-gradient(ellipse at 50% 38%, transparent 34%, rgb(31 9 19 / .55) 100%); }

  .dust { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .dust i { position: absolute; bottom: -12px; left: var(--x); width: var(--s); height: var(--s); border-radius: 50%; background: var(--gold); opacity: 0; box-shadow: 0 0 8px 1px rgb(201 148 76 / .55); animation: float var(--d) linear infinite; animation-delay: var(--delay); }
  .twinkle { position: absolute; color: var(--gold); opacity: 0; animation: twinkle 6s ease-in-out infinite; animation-delay: var(--delay); }

  .scroll-cue { position: absolute; z-index: 2; left: 50%; bottom: 20px; transform: translateX(-50%); width: 44px; height: 44px; display: grid; place-items: center; }
  .scroll-cue span { display: block; width: 1px; height: 36px; background: linear-gradient(var(--gold), transparent); transform-origin: top; animation: cue 3.2s var(--ease) infinite 3.2s; opacity: .0; }

  @keyframes logo-in { from { opacity: 0; transform: translateY(10px) scale(.965); } to { opacity: 1; transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes breathe { 0%, 100% { opacity: .75; transform: translate(-50%, -50%) scale(1); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.06); } }
  @keyframes float { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 12% { opacity: var(--o); } 85% { opacity: var(--o); } 100% { transform: translate3d(14px, -105svh, 0); opacity: 0; } }
  @keyframes twinkle { 0%, 100% { opacity: 0; transform: scale(.6); } 50% { opacity: .75; transform: scale(1); } }
  @keyframes cue { 0% { opacity: 0; transform: scaleY(0); } 40% { opacity: .9; transform: scaleY(1); } 100% { opacity: 0; transform: scaleY(1) translateY(10px); } }

  @media (max-width: 767px) { .hero { padding-bottom: 52px; } .hero-cta .btn { width: 100%; } .scroll-cue { display: none; } .hero-lead { margin-top: 20px; } }
  @media (prefers-reduced-motion: reduce) {
    .bloom-stage, .bloom-word { display: none; }
    .hero-logo-media, .hero-eyebrow, .hero-tag .line, .hero-lead, .hero-cta { animation: none; }
    .dust, .scroll-cue { display: none; }
    .glow { animation: none; }
  }
</style>
