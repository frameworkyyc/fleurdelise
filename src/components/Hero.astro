---
import Button from './Button.astro';
import { site } from '../data/site';
// Deterministic "gold dust" so builds are stable (no Math.random at render time).
const motes = Array.from({ length: 18 }, (_, i) => {
  const r = (n: number) => { const x = Math.sin((i + 1) * 9301 + n * 49297) * 233280; return x - Math.floor(x); };
  return { x: Math.round(r(1) * 100), s: 2 + Math.round(r(2) * 2), d: 14 + Math.round(r(3) * 14), delay: -Math.round(r(4) * 26), o: 0.35 + r(5) * 0.45 };
});
const stars = [{ x: 14, y: 24, d: 0 }, { x: 86, y: 30, d: 1.6 }, { x: 22, y: 70, d: 3.1 }, { x: 80, y: 74, d: 2.2 }];
---
<section class="hero tex-plum on-dark" aria-labelledby="hero-title" data-hero>
  <div class="glow" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="dust" aria-hidden="true">
    {motes.map((m) => <i style={`--x:${m.x}%;--s:${m.s}px;--d:${m.d}s;--delay:${m.delay}s;--o:${m.o}`}></i>)}
    {stars.map((s) => (
      <svg class="twinkle" style={`left:${s.x}%;top:${s.y}%;--delay:${s.d}s`} viewBox="0 0 24 24" width="14" height="14"><path d="M12 1c.7 6.5 2.500 9.300 11 11-8.500 1.700-10.300 4.500-11 11-.7-6.500-2.500-9.300-11-11 8.500-1.700 10.300-4.500 11-11z" fill="currentColor" /></svg>
    ))}
  </div>

  <div class="wrap hero-in">
    <!--
      SAFARI-SAFE — DO NOT add animated filters here. The original blur()/drop-shadow() keyframes rendered as a white
      rectangle on iPad Safari Private Browsing (docs/SAFARI-LOGO.md). Animate opacity/transform only; keep fill-mode
      `backwards` so the base state is always visible. (Enforced by scripts/check-motion.mjs.)
    -->
    <div class="hero-logo-frame">
      <picture>
        <source type="image/webp" srcset="/brand/logo-dark-768.webp 768w, /brand/logo-dark-1024.webp 1024w, /brand/logo-dark-1536.webp 1536w" sizes="(max-width: 700px) 92vw, 640px" />
        <img class="hero-logo" data-hero-logo src="/brand/logo-dark-1024.png" width="1536" height="1024" alt={`${site.name} — lotus, crescent moon and stars`} fetchpriority="high" />
      </picture>
    </div>
    <p class="eyebrow hero-eyebrow">Reiki · EFT · Tarot <span aria-hidden="true">—</span> In-person &amp; virtual</p>
    <h1 id="hero-title" class="display hero-tag">
      <span class="line">{site.tagline[0]}</span>
      <span class="line">{site.tagline[1]}</span>
    </h1>
    <p class="lead hero-lead">Gentle, personal wellness support in Windsor, Ontario — in person or virtually, depending on the service.</p>
    <div class="hero-cta">
      <Button href={site.book.href} data-hero-cta>{site.book.cta}</Button>
      <a class="link-arrow" href="/services">Explore services</a>
    </div>
  </div>
  <a class="scroll-cue" href="#welcome" aria-label="Scroll to content"><span></span></a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: center; padding: calc(var(--header-h) + 8px) 0 72px; overflow: hidden; text-align: center; }
  .hero-in { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; }

  .hero-logo-frame { position: relative; isolation: isolate; width: clamp(280px, min(92vw, 640px, calc((100svh - 520px) * 1.5)), 640px); margin-bottom: 8px; animation: logo-in 1.8s var(--ease-slow) backwards .1s; }
  .hero-logo { display: block; width: 100%; height: auto; }
  /* soft ambient shadow — replaces the former `filter: drop-shadow()`; animated filters broke iPad Safari Private Browsing */
  .hero-logo-frame::before { content: ''; position: absolute; z-index: -1; inset: 18% 6% -6%; background: radial-gradient(closest-side, rgb(0 0 0 / .34), rgb(0 0 0 / .14) 55%, transparent 100%); }
  .hero-eyebrow { color: var(--gold); margin: 12px 0 20px; animation: rise 1.4s var(--ease-slow) backwards 1.1s; max-width: 30ch; text-wrap: balance; }
  .hero-tag { display: grid; gap: 2px; }
  .hero-tag .line { display: block; text-wrap: balance; animation: rise 1.6s var(--ease-slow) backwards; }
  .hero-tag .line:nth-child(1) { animation-delay: 1.3s; }
  .hero-tag .line:nth-child(2) { animation-delay: 1.7s; }
  .hero-lead { max-width: 46ch; margin: 24px auto 0; color: var(--ivory-80); animation: rise 1.4s var(--ease-slow) backwards 2.1s; }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 32px; margin-top: 36px; animation: rise 1.4s var(--ease-slow) backwards 2.4s; }

  /* candlelight glow (Brand Kit §05 "Ritual") */
  .glow { position: absolute; z-index: 0; width: 120vmin; height: 120vmin; left: 50%; top: 34%; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(circle, rgb(207 128 92 / .30) 0%, rgb(160 87 58 / .14) 34%, transparent 68%); animation: breathe 11s ease-in-out infinite; }
  .vignette { position: absolute; inset: 0; z-index: 1; background: radial-gradient(ellipse at 50% 40%, transparent 38%, rgb(31 9 19 / .6) 100%); }

  .dust { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .dust i { position: absolute; bottom: -12px; left: var(--x); width: var(--s); height: var(--s); border-radius: 50%; background: var(--gold); opacity: 0; box-shadow: 0 0 8px 1px rgb(201 148 76 / .55); animation: float var(--d) linear infinite; animation-delay: var(--delay); }
  .twinkle { position: absolute; color: var(--gold); opacity: 0; animation: twinkle 6s ease-in-out infinite; animation-delay: var(--delay); }

  .scroll-cue { position: absolute; z-index: 2; left: 50%; bottom: 20px; translate: -50% 0; width: 44px; height: 44px; display: grid; place-items: center; }
  .scroll-cue span { display: block; width: 1px; height: 36px; background: linear-gradient(var(--gold), transparent); transform-origin: top; animation: cue 3.2s var(--ease) infinite 3.2s; opacity: .0; }

  @keyframes logo-in { from { opacity: 0; transform: translateY(14px) scale(.975); } to { opacity: 1; transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes breathe { 0%, 100% { opacity: .75; scale: 1; } 50% { opacity: 1; scale: 1.06; } }
  @keyframes float { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 12% { opacity: var(--o); } 85% { opacity: var(--o); } 100% { transform: translate3d(14px, -105svh, 0); opacity: 0; } }
  @keyframes twinkle { 0%, 100% { opacity: 0; transform: scale(.6); } 50% { opacity: .75; transform: scale(1); } }
  @keyframes cue { 0% { opacity: 0; transform: scaleY(0); } 40% { opacity: .9; transform: scaleY(1); } 100% { opacity: 0; transform: scaleY(1) translateY(10px); } }

  @media (max-width: 767px) { .hero { padding-bottom: 96px; } .hero-cta .btn { width: 100%; } .scroll-cue { display: none; } .hero-lead { margin-top: 20px; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo-frame, .hero-eyebrow, .hero-tag .line, .hero-lead, .hero-cta { animation: none; }
    .dust, .scroll-cue { display: none; }
    .glow { animation: none; }
  }
</style>
