---
import Portrait from './Portrait.astro';
import Divider from './Divider.astro';
import { training } from '../data/site';
// Verified credentials only (docs/CREDENTIALS.md): the completed Reiki certification + tarot experience.
const reiki = training.primary.find((t) => /Reiki/.test(t.title) && !t.upcoming)!;
const tarot = training.primary.find((t) => /tarot/i.test(t.title))!;
---
<section id="welcome" class="section tex-linen on-light intro" aria-labelledby="intro-title">
  <div class="wrap">
    <Divider tone="bronze" />
    <div class="grid">
      <Portrait class="portrait-slot reveal" />
      <div class="head">
        <p class="eyebrow reveal">Meet Lise</p>
        <h2 id="intro-title" class="reveal" style="--d:1">A practitioner who understands.</h2>
      </div>
      <div class="body">
        <p class="lead reveal" style="--d:2">I offer gentle, personal support for people who are carrying something they haven’t been able to put down.</p>
        <p class="creds reveal" style="--d:3"><span>{reiki.title}</span><span class="dot" aria-hidden="true">·</span><span>Tarot {tarot.when.toLowerCase()}</span></p>
        <p class="reveal" style="--d:3"><a class="link-arrow" href="/about">More about Lise <svg width="18" height="18" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 24h34M28 12l12 12-12 12"/></svg></a></p>
      </div>
    </div>
  </div>
</section>
<style>
  .intro { padding-top: clamp(40px, 7vw, 72px); }
  .grid { display: grid; grid-template-columns: 112px 1fr; grid-template-areas: 'p h' 'b b'; gap: 22px 20px; align-items: center; }
  .grid :global(.portrait-slot) { grid-area: p; }
  .head { grid-area: h; } .body { grid-area: b; display: grid; gap: 16px; }
  .head h2 { margin-top: 8px; font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.5rem); }
  .body .lead { color: var(--plum); }
  .creds { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; padding: 12px 0; border-block: 1px solid rgb(151 92 43 / .35); font-family: var(--font-serif); font-style: italic; font-size: 1.0625rem; color: var(--plum); }
  .creds .dot { color: var(--bronze); }
  @media (min-width: 700px) { .grid { grid-template-columns: 190px 1fr; gap: 28px 32px; } .head h2 { font-size: clamp(1.875rem, 1.4rem + 1.2vw, 2.25rem); } .body .lead { max-width: 56ch; } }
  @media (min-width: 900px) {
    .intro { padding-top: var(--section-y); }
    .grid { grid-template-columns: 5fr 6fr; grid-template-areas: 'p h' 'p b'; gap: 20px 96px; align-items: start; }
    .grid :global(.portrait-slot) { grid-row: 1 / span 2; align-self: center; }
    .head { align-self: end; max-width: 560px; } .body { align-self: start; max-width: 560px; gap: 22px; }
  }
</style>
