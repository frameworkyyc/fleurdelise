---
// Arch portrait. Shows Lise's photo when supplied (site.lise.photo). Until then: a botanical still-life photograph (NOT Lise — decorative,
// aria-hidden) inside the brand arch. Compact on phones (sits beside the heading), full arch from 900px.
import { Picture } from 'astro:assets';
import botanical from '../assets/photos/botanical.jpg';
import { site } from '../data/site';
interface Props { class?: string }
const { class: cls } = Astro.props;
const { photo, photoAlt } = site.lise;
---
<div class:list={['portrait', cls]} aria-hidden={photo ? undefined : 'true'}>
  {photo ? (
    <Picture src={photo} alt={photoAlt ?? 'Lise Pinard-Wolf'} formats={['avif', 'webp']} widths={[240, 480, 720, 960]} sizes="(max-width: 699px) 132px, (max-width: 899px) 200px, 460px" class="photo" />
  ) : (
    <Picture src={botanical} alt="" formats={['avif', 'webp']} widths={[240, 480, 720, 960]} sizes="(max-width: 699px) 132px, (max-width: 899px) 200px, 460px" loading="lazy" decoding="async" class="photo still" />
  )}
</div>
<style>
  .portrait { position: relative; aspect-ratio: 4 / 5; width: 112px; overflow: hidden; border-radius: 999px 999px 4px 4px; background: var(--midnight);
    box-shadow: 0 0 0 1px rgb(151 92 43 / .45), 0 18px 36px -22px rgb(76 31 49 / .6); }
  .portrait :global(.photo) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .portrait :global(.still) { object-position: 55% 40%; }
  @media (min-width: 700px) { .portrait { width: 190px; } }
  @media (min-width: 900px) { .portrait { width: min(100%, 440px); border-radius: 999px 999px 6px 6px; box-shadow: 0 0 0 1px rgb(151 92 43 / .28), 0 40px 80px -40px rgb(76 31 49 / .45); } }
</style>
