---
import { site } from '../data/site';
interface Props { kind: 'book' | 'contact' }
const { kind } = Astro.props;
const isBook = kind === 'book';
// Public Turnstile site key (build-time). Staging/dev default to Cloudflare's always-pass TEST key; production must set PUBLIC_TURNSTILE_SITEKEY.
const siteKey = (import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined) || (import.meta.env.PUBLIC_SITE_ENV === 'production' ? '' : '1x00000000000000000000AA');
import { LIMITS } from '../lib/inquiry-options';
---
<form class="form" data-inquiry={kind} data-to={site.email} data-phone={site.phone} data-phone-href={site.phoneHref} data-sitekey={siteKey} novalidate>
  <div class="hp" aria-hidden="true"><label>Leave this empty<input type="text" name="hp_x7k2" tabindex="-1" autocomplete="off" data-lpignore="true" data-1p-ignore="true" /></label></div>
  <noscript><p class="form-note">This form needs JavaScript. You can email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a> instead.</p></noscript>

  {isBook && (
    <>
      <fieldset class="fieldset" data-group="service" aria-describedby="service-err">
        <legend class="legend"><span class="n">01</span>Which service interests you?</legend>
        <div class="choices">
          <label class="choice"><input type="radio" name="service" value="reiki" /><span>Reiki</span></label>
          <label class="choice"><input type="radio" name="service" value="eft" /><span>Emotional Freedom Technique (EFT)</span></label>
          <label class="choice"><input type="radio" name="service" value="tarot" /><span>Tarot reading</span></label>
          <label class="choice"><input type="radio" name="service" value="unsure" /><span>Not sure yet</span></label>
        </div>
        <p class="error" id="service-err" role="alert"></p>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="legend"><span class="n">02</span>In person or virtual?</legend>
        <div class="choices cols">
          <label class="choice"><input type="radio" name="format" value="in-person" /><span>In person</span></label>
          <label class="choice"><input type="radio" name="format" value="virtual" /><span>Virtual</span></label>
          <label class="choice"><input type="radio" name="format" value="either" checked /><span>No preference</span></label>
        </div>
        <p class="hint">Which options are available depends on the service — Lise will confirm when she replies.</p>
      </fieldset>

      <fieldset class="fieldset">
        <legend class="legend"><span class="n">03</span>When might suit you?</legend>
        <div class="field">
          <label for="times">Days or times that tend to work <span class="opt">(optional)</span></label>
          <textarea class="textarea" id="times" name="times" rows="3" maxlength={LIMITS.times} placeholder="e.g. weekday mornings, or Saturdays"></textarea>
        </div>
      </fieldset>
    </>
  )}

  <fieldset class="fieldset">
    <legend class="legend">{isBook && <span class="n">04</span>}{isBook ? 'A little about you' : 'Send a message'}</legend>
    <div class="grid-2">
      <div class="field">
        <label for="name">Your name</label>
        <input class="input" id="name" name="name" type="text" autocomplete="name" maxlength={LIMITS.name} aria-describedby="name-err" required />
        <p class="error" id="name-err" role="alert"></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength={LIMITS.email} aria-describedby="email-err" required />
        <p class="error" id="email-err" role="alert"></p>
      </div>
    </div>
    <div class="field">
      <label for="phone">Phone <span class="opt">(optional)</span></label>
      <input class="input" id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength={LIMITS.phone} aria-describedby="phone-err" />
      <p class="error" id="phone-err" role="alert"></p>
    </div>
    {!isBook && (
      <div class="field">
        <label for="topic">What is this about?</label>
        <select class="select" id="topic" name="topic">
          <option value="general">A general question</option>
          <option value="appointment">An appointment inquiry</option>
          <option value="sit">SIT — let me know when sessions open</option>
        </select>
      </div>
    )}
    <div class="field">
      <label for="message">{isBook ? 'Anything you’d like Lise to know' : 'Your message'} {isBook && <span class="opt">(optional)</span>}</label>
      <textarea class="textarea" id="message" name="message" rows="5" maxlength={LIMITS.message} aria-describedby="message-err" required={!isBook}></textarea>
      <p class="error" id="message-err" role="alert"></p>
    </div>
  </fieldset>

  <p class="form-note">Please keep health details out of this form — there’s plenty of time to share what feels right in your session.</p>

  <div class="field">
    <label class="check"><input type="checkbox" name="consent" aria-describedby="consent-err" />
      <span>{isBook
        ? 'I understand this is an appointment inquiry — nothing is booked until Lise replies to confirm a time.'
        : 'I’m happy for Lise to reply to me at the email address above.'}</span></label>
    <p class="error" id="consent-err" role="alert"></p>
  </div>

  <div class="turnstile" data-turnstile></div>

  <div class="notice" data-notice role="alert" tabindex="-1" hidden>
    <p class="notice-title" data-notice-title></p>
    <p data-notice-text></p>
    <div class="notice-actions" data-notice-actions hidden>
      <a class="btn btn-sm" data-fallback-mail href={`mailto:${site.email}`}>Email Lise instead</a>
      <button class="btn btn-ghost-dark btn-sm" type="button" data-copy>Copy my message</button>
      <a class="link-arrow" href={site.phoneHref}>Call {site.phone}</a>
    </div>
    <pre class="copy-box" data-copy-text tabindex="0" aria-label="Your message, to copy" hidden></pre>
  </div>

  <div class="submit-row">
    <button class="btn btn-plum" type="submit" data-submit>{isBook ? 'Send my inquiry' : 'Send message'}</button>
    <p class="hint small-print">Trouble sending? Email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a>. This form is protected by Cloudflare Turnstile (<a href="/privacy">privacy</a>).</p>
  </div>
</form>

<div class="result" data-result role="status" data-kind={kind}>
  <h2 tabindex="-1">{isBook ? 'Thank you — your request has been sent' : 'Thank you — your message has been sent'}</h2>
  {isBook ? (
    <p><strong>Your appointment is not confirmed yet.</strong> Lise has your request and will reply to confirm a time and format. Nothing is booked until you hear from her.</p>
  ) : (
    <p>Lise has your message and will reply when she can.</p>
  )}
  <p data-ack-yes hidden>We’ve emailed an acknowledgement to <strong data-ack-email></strong>. If it doesn’t arrive within a few minutes, please check your spam or junk folder.</p>
  <p data-ack-no hidden>We couldn’t send you an acknowledgement email, but Lise has your {isBook ? 'request' : 'message'}. Please keep your reference number below.</p>
  <p class="result-ref">Reference: <strong data-ref></strong></p>
  <p class="result-mock" data-mock hidden><strong>Test mode:</strong> this is a test environment — no email was actually sent.</p>
  <p class="result-small">Need to change something? Email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
  <div class="actions">
    <a class="btn" href="/">Back to home</a>
    <button class="btn btn-ghost-light btn-sm" type="button" data-again>{isBook ? 'Send another request' : 'Send another message'}</button>
  </div>
</div>
