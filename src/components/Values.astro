---
import Divider from './Divider.astro';
const values = [
  { name: 'Safe', text: 'Your pace, your privacy, your choice — always.' },
  { name: 'Nurturing', text: 'Gentle support for whatever you’re carrying.' },
  { name: 'Authentic', text: 'Plain words and real presence. No performance, no judgment.' },
];
---
<section class="section tex-linen on-light values" aria-labelledby="values-title">
  <div class="wrap">
    <Divider tone="bronze" />
    <h2 id="values-title" class="reveal">A safe space to bloom.</h2>
    <ul class="trio">
      {values.map((v, i) => (
        <li class="reveal" style={`--d:${i + 1}`}>
          <h3 class="serif">{v.name}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .values { padding-block: clamp(40px, 7vw, 96px); }
  h2 { text-align: center; margin: 0 0 clamp(20px, 4vw, 44px); font-size: clamp(1.5rem, 1.25rem + 1.2vw, 2.25rem); }
  .trio { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; margin: 0; padding: 0; }
  .trio li { padding: 4px clamp(8px, 2.5vw, 40px); text-align: center; }
  .trio li + li { border-left: 1px solid rgb(151 92 43 / .4); }
  .trio h3 { font-style: italic; font-weight: 400; font-size: clamp(1.25rem, .95rem + 1.4vw, 2rem); line-height: 1.15; color: var(--plum); }
  .trio p { margin: 8px auto 0; color: var(--plum-text-soft); font-size: clamp(.75rem, .68rem + .35vw, .9375rem); line-height: 1.5; max-width: 26ch; text-wrap: balance; }
  @media (max-width: 359px) { .trio p { font-size: .75rem; } }
</style>
