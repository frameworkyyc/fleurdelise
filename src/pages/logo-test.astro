---
// STAGING-ONLY diagnostics for the Safari/iPad hero-logo issue. Unlinked, noindex, never sitemapped,
// and stripped from production builds (scripts/post-build.mjs). Safe to delete once the issue is closed.
import BaseLayout from '../layouts/BaseLayout.astro';

const variants = [
  { id: 'A', title: 'Previous encoding (lossy + alpha WebP), no effects', note: 'VP8X+ALPH+VP8 — what the hero used before', src: '/brand/diag/logo-lossy-alpha-768.webp', cls: '' },
  { id: 'B', title: 'Previous encoding + static drop-shadow filter', note: 'Tests CSS filter on the image', src: '/brand/diag/logo-lossy-alpha-768.webp', cls: 'v-shadow' },
  { id: 'C', title: 'Previous encoding + ORIGINAL animation', note: 'blur + drop-shadow keyframes with fill-mode: both', src: '/brand/diag/logo-lossy-alpha-768.webp', cls: 'v-orig' },
  { id: 'D', title: 'New encoding (near-lossless WebP), no effects', note: 'VP8L — no separate alpha plane', src: '/brand/logo-dark-768.webp', cls: '' },
  { id: 'E', title: 'PNG fallback, no effects', note: 'Universal format', src: '/brand/logo-dark-1024.png', cls: '' },
  { id: 'F', title: 'NEW hero implementation', note: '<picture> + opacity/transform animation only', src: '', cls: 'v-new' },
];
---
<BaseLayout title="Logo diagnostics" description="Internal diagnostics page." path="/logo-test" noindex bookBar={false}>
  <section class="diag tex-plum on-dark">
    <div class="wrap">
      <p class="eyebrow">Internal · staging only</p>
      <h1>Logo rendering diagnostics</h1>
      <p class="lead">Open this on the iPad and screenshot the whole page. Each tile isolates one possible cause. Tell us which letters show a white box, a blank area, or the correct logo.</p>
      <pre id="env" class="env" aria-live="polite">collecting…</pre>
      <button type="button" class="btn btn-sm" id="replay">Replay animations</button>

      <ul class="grid">
        {variants.map((v) => (
          <li class="tile">
            <p class="tag"><b>{v.id}</b> · {v.title}</p>
            <p class="note">{v.note}</p>
            <div class={`stage ${v.cls}`}>
              {v.id === 'F' ? (
                <div class="frame">
                  <picture>
                    <source type="image/webp" srcset="/brand/logo-dark-768.webp 768w, /brand/logo-dark-1024.webp 1024w" sizes="320px" />
                    <img data-diag="F" src="/brand/logo-dark-1024.png" width="1536" height="1024" alt="Logo variant F" />
                  </picture>
                </div>
              ) : (
                <img data-diag={v.id} class="probe" src={v.src} width="1536" height="1024" alt={`Logo variant ${v.id}`} />
              )}
            </div>
            <p class="res" data-res={v.id}>…</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .diag { padding: calc(var(--header-h) + 40px) 0 80px; }
  .diag h1 { margin: 8px 0 12px; } .diag .lead { color: var(--ivory-80); max-width: 60ch; }
  .env { margin: 20px 0; padding: 14px 16px; background: rgb(31 9 19 / .6); border: 1px solid rgb(201 148 76 / .35); font: 12px/1.5 ui-monospace, Menlo, monospace; white-space: pre-wrap; color: var(--ivory-80); }
  .diag .grid { display: grid; gap: 24px; margin-top: 32px; list-style: none; padding: 0; }
  @media (min-width: 700px) { .diag .grid { grid-template-columns: 1fr 1fr; } }
  .diag .tile { padding: 16px; background: rgb(31 9 19 / .45); border-top: 2px solid var(--gold); }
  .diag .tag { font-weight: 500; } .diag .note, .diag .res { font-size: .8125rem; color: var(--ivory-60); } .diag .res { margin-top: 10px; font-family: ui-monospace, Menlo, monospace; white-space: pre-wrap; color: var(--ivory-80); }
  .diag .stage { margin-top: 12px; background: var(--plum); padding: 12px; min-height: 120px; }
  .diag .stage img { width: min(100%, 320px); height: auto; display: block; margin-inline: auto; }
  .diag .v-shadow img { filter: drop-shadow(0 18px 40px rgb(0 0 0 / .35)); }
  .diag .v-orig img { filter: drop-shadow(0 18px 40px rgb(0 0 0 / .35)); animation: orig-in 2.2s var(--ease-slow) both .15s; }
  @keyframes orig-in { from { opacity: 0; transform: translateY(14px) scale(.975); filter: blur(8px) drop-shadow(0 18px 40px rgb(0 0 0 / .35)); } to { opacity: 1; transform: none; filter: blur(0) drop-shadow(0 18px 40px rgb(0 0 0 / .35)); } }
  .diag .frame { position: relative; isolation: isolate; width: min(100%, 320px); margin-inline: auto; animation: new-in 1.8s var(--ease-slow) backwards .1s; }
  .diag .frame::before { content: ''; position: absolute; z-index: -1; inset: 18% 6% -6%; background: radial-gradient(closest-side, rgb(0 0 0 / .34), rgb(0 0 0 / .14) 55%, transparent 100%); }
  .diag .frame img { width: 100%; }
  @keyframes new-in { from { opacity: 0; transform: translateY(14px) scale(.975); } to { opacity: 1; transform: none; } }
</style>

<script>
  const out = document.getElementById('env')!;
  const lines = [
    `UA: ${navigator.userAgent}`,
    `viewport: ${innerWidth}x${innerHeight} @${devicePixelRatio}x`,
    `reduced-motion: ${matchMedia('(prefers-reduced-motion: reduce)').matches}`,
    `CSS filter: ${CSS.supports('filter', 'blur(1px)')} · individual transform props: ${CSS.supports('translate', '1px')}`,
  ];
  out.textContent = lines.join('\n');

  const report = async (img: HTMLImageElement) => {
    const id = img.dataset.diag!;
    const el = document.querySelector(`[data-res="${id}"]`)!;
    let dec = 'decode(): ';
    try { await img.decode(); dec += 'OK'; } catch (e) { dec += `FAILED (${(e as Error).name})`; }
    const f = getComputedStyle(img).filter;
    el.textContent = `${dec}\nnatural ${img.naturalWidth}x${img.naturalHeight} · complete=${img.complete}\nsrc: ${(img.currentSrc || img.src).split('/').pop()}\nfilter: ${f}`;
  };
  const imgs = [...document.querySelectorAll<HTMLImageElement>('img[data-diag]')];
  imgs.forEach((i) => { if (i.complete) report(i); else { i.addEventListener('load', () => report(i)); i.addEventListener('error', () => report(i)); } });

  document.getElementById('replay')!.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.diag .v-orig img, .diag .frame').forEach((el) => {
      el.style.animation = 'none'; void el.offsetWidth; el.style.animation = '';
    });
  });
</script>
