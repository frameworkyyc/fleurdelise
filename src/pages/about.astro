---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Portrait from '../components/Portrait.astro';
import Icon from '../components/Icon.astro';
import Invitation from '../components/Invitation.astro';
import { site, training } from '../data/site';
import { personSchema, breadcrumbSchema } from '../data/schema';
const { bio } = site.lise;
const principles = [
  { icon: 'heart', title: 'Personal connection', text: 'One-to-one, unhurried, and always at your pace.' },
  { icon: 'inperson', title: 'Compassion', text: 'Whatever you’re carrying is welcome here.' },
  { icon: 'sit', title: 'No judgment', text: 'You’re met with understanding. Your story is yours to share.' },
  { icon: 'tarot', title: 'Authenticity', text: 'Plain words and real presence — no performance.' },
] as const;
const jsonLd = [personSchema(), breadcrumbSchema([{ name: 'Home', href: '/' }, { name: 'About', href: '/about' }])];
---
<BaseLayout title="About Lise Pinard-Wolf | Fleur de Lise Healing, Windsor" description="Meet Lise Pinard-Wolf — a Windsor, Ontario Certified Master Usui Reiki Practitioner and tarot reader (since 2003), with EFT training. No judgment." path="/about" jsonLd={jsonLd}>
  <PageHero crumbs={[{ name: 'Home', href: '/' }, { name: 'About' }]} eyebrow="About Lise" title="A practitioner who understands." lead="Gentle, personal support for people who are carrying something they haven’t been able to put down." />

  <section class="section tex-linen on-light" aria-labelledby="who-h">
    <div class="wrap grid">
      <Portrait class="reveal" />
      <div class="copy">
        <p class="eyebrow reveal">Hello, I’m Lise</p>
        <h2 id="who-h" class="reveal" style="--d:1">Come as you are.</h2>
        <div class="prose reveal" style="--d:2">
          <p class="lead">I’m Lise Pinard-Wolf, and I offer <a href="/services/reiki">Reiki</a>, <a href="/services/eft">EFT tapping</a> and <a href="/services/tarot">tarot readings</a> in Windsor, Ontario — in person and virtually, depending on the service.</p>
          <p>My own life experience means I meet everyone with understanding, not judgment. You decide what to share, and we move at the pace that feels right for you.</p>
          <p>I’ve practiced tarot since 2003 and am a Certified Master Usui Reiki Practitioner. <a href="#training">See all my training and certifications.</a></p>
          {bio?.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section tex-midnight on-dark" aria-labelledby="how-h">
    <div class="wrap">
      <p class="eyebrow reveal">My approach</p>
      <h2 id="how-h" class="reveal" style="--d:1">How I hold space</h2>
      <ul class="cards">
        {principles.map((p, i) => (
          <li class="card reveal" style={`--d:${i}`}><Icon name={p.icon} size={48} class="ico" /><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="training" class="section tex-ivory on-light" aria-labelledby="cred-h">
    <div class="wrap train">
      <div class="train-intro">
        <p class="eyebrow reveal">Experience &amp; study</p>
        <h2 id="cred-h" class="reveal" style="--d:1">Training &amp; certifications</h2>
        <p class="lead reveal" style="--d:2">Reiki, EFT and tarot readings are the services I offer today. SIT is not yet offered — certification expected April 2027.</p>
      </div>
      <div class="train-body">
        <ol class="primary reveal" style="--d:2">
          {training.primary.map((t) => (
            <li class:list={[t.upcoming && 'is-upcoming']}>
              <span class="when serif">{t.whenISO ? <time datetime={t.whenISO}>{t.when}</time> : t.when}</span>
              <span class="what serif">{t.title}</span>
              {t.note && <span class="note">{t.note}</span>}
            </li>
          ))}
        </ol>
        <h3 class="more-h reveal" style="--d:3">Additional training &amp; certifications</h3>
        <ul class="extra reveal" style="--d:3">{training.additional.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section tex-linen on-light" aria-labelledby="wel-h">
    <div class="wrap welcome">
      <div><p class="eyebrow">A welcoming space</p><h2 id="wel-h">Safe. Nurturing. Authentic.</h2></div>
      <div class="prose">
        <p class="lead">Fleur de Lise Healing is a quiet place to arrive exactly as you are — whether we meet in person in Windsor or online.</p>
        <p>These aren’t just words on a page: they’re the three values behind every session. You can ask questions, take your time, and change your mind. There’s no right way to begin.</p>
      </div>
    </div>
  </section>
  <Invitation />
</BaseLayout>
<style>
  .grid { display: grid; gap: 56px; align-items: center; } .copy { max-width: 560px; } .copy h2 { margin: 12px 0 28px; }
  .prose p { color: var(--plum-text-soft); } .prose .lead { color: var(--plum); }
  @media (min-width: 900px) { .grid { grid-template-columns: 5fr 6fr; gap: 96px; } }
  h2 { margin-top: 12px; }
  .cards { display: grid; gap: 20px; margin-top: clamp(40px, 5vw, 64px); }
  .card { background: var(--plum); padding: 40px 32px; border-top: 2px solid var(--gold); display: grid; gap: 12px; align-content: start; }
  .card :global(.ico) { color: var(--gold); margin-bottom: 8px; } .card p { color: var(--ivory-80); }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } } @media (min-width: 1100px) { .cards { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .train { display: grid; gap: 40px; } @media (min-width: 900px) { .train { grid-template-columns: 5fr 7fr; gap: 96px; } }
  .train-intro .lead { margin-top: 24px; max-width: 34ch; color: var(--plum-text-soft); }
  .primary { list-style: none; margin: 0; padding: 0; }
  .primary li { display: grid; grid-template-columns: minmax(8.5rem, 11rem) 1fr; gap: 4px 24px; align-items: baseline; padding: 20px 0; border-top: 1px solid rgb(151 92 43 / .35); }
  .primary li:last-child { border-bottom: 1px solid rgb(151 92 43 / .35); }
  .primary .when { font-style: italic; color: var(--bronze-text); font-size: 1.0625rem; }
  .primary .what { font-size: clamp(1.1875rem, 1.1rem + .4vw, 1.375rem); color: var(--plum); line-height: 1.3; }
  .primary .note { grid-column: 2; font-size: .8125rem; letter-spacing: .06em; text-transform: uppercase; color: var(--bronze-text); }
  .primary .is-upcoming .what { color: var(--plum-text-soft); }
  @media (max-width: 560px) { .primary li { grid-template-columns: 1fr; } .primary .note { grid-column: 1; } }
  .more-h { margin-top: clamp(36px, 5vw, 56px); font-family: var(--font-sans); font-weight: 500; font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase; color: var(--bronze-text); }
  .extra { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 12px 40px; }
  @media (min-width: 700px) { .extra { grid-template-columns: repeat(2, 1fr); } }
  .extra li { position: relative; padding-left: 20px; color: var(--plum-text-soft); font-size: .9375rem; line-height: 1.5; }
  .extra li::before { content: ''; position: absolute; left: 3px; top: .62em; width: 5px; height: 5px; background: var(--gold); transform: rotate(45deg); }
  .welcome { display: grid; gap: 32px; } @media (min-width: 900px) { .welcome { grid-template-columns: 5fr 7fr; gap: 96px; } }
</style>
