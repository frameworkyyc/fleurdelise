---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LiseIntro from '../components/LiseIntro.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import Values from '../components/Values.astro';
import SitAnnouncement from '../components/SitAnnouncement.astro';
import Invitation from '../components/Invitation.astro';
import { businessSchema, websiteSchema } from '../data/schema';

const title = 'Reiki, EFT & Tarot in Windsor, Ontario | Fleur de Lise Healing';
const description = 'Reiki, EFT tapping and tarot readings with Lise Pinard-Wolf in Windsor, Ontario. Gentle, personal support, in person or virtually depending on the service.';
const jsonLd = [businessSchema(description), websiteSchema()];
---
<BaseLayout title={title} description={description} path="/" home jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" type="image/webp" href="/brand/logo-dark-1024.webp" imagesrcset="/brand/logo-dark-768.webp 768w, /brand/logo-dark-1024.webp 1024w, /brand/logo-dark-1280.webp 1280w, /brand/logo-dark-1536.webp 1536w" imagesizes="(max-width: 700px) 92vw, 640px" fetchpriority="high" />
  <Hero />
  <LiseIntro />
  <ServicesOverview />
  <Values />
  <SitAnnouncement />
  <Invitation />
</BaseLayout>
