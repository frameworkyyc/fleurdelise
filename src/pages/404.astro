---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Moons from '../components/Moons.astro';
---
<BaseLayout title="Page not found | Fleur de Lise Healing" description="This page could not be found." noindex bookBar={false}>
  <section class="nf tex-plum on-dark">
    <Moons class="m" />
    <h1 class="display">This path is quiet.</h1>
    <p class="lead">The page you’re looking for isn’t here. Let’s find your way back.</p>
    <Button href="/">Return home</Button>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 100svh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 24px; padding: 120px var(--gutter) 80px; }
  .m { color: var(--gold); opacity: .8; } .lead { color: var(--ivory-80); max-width: 36ch; }
</style>
