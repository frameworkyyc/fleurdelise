{
  // Static Astro site served by Cloudflare Workers Static Assets.
  // NOTE: nothing here deploys by itself. Production deploys require explicit approval.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleurdelise",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
