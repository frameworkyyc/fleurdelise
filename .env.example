# Defaults are staging-safe: with these unset, every page is noindex and robots.txt disallows all.
# Staging build (npm run build:staging) sets them for you:
PUBLIC_SITE_ENV=staging
PUBLIC_SITE_URL=https://fleurdelise.frameworktools.ca
# Production (npm run build:production) — ONLY when go-live is approved:
# PUBLIC_SITE_ENV=production
