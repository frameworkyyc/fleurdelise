{
  "name": "fleurdelise",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-motion.mjs && astro build && node scripts/post-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "build:staging": "PUBLIC_SITE_ENV=staging PUBLIC_SITE_URL=https://fleurdelise.frameworktools.ca PUBLIC_TURNSTILE_SITEKEY=${PUBLIC_TURNSTILE_SITEKEY:-1x00000000000000000000AA} npm run build",
    "build:production": "PUBLIC_SITE_ENV=production npm run build",
    "check:motion": "node scripts/check-motion.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:redirects": "node scripts/build-redirects.mjs --check-only",
    "test:worker": "node --test scripts/test-worker.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22"
  }
}
