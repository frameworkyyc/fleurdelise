{
  "name": "fleurdelise",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/post-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "build:staging": "PUBLIC_SITE_ENV=staging PUBLIC_SITE_URL=https://fleurdelise.frameworktools.ca npm run build",
    "build:production": "PUBLIC_SITE_ENV=production npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
